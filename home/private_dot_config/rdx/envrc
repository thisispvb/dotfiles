# Work env, loaded by direnv under ~/git/rdx only (see ~/.config/direnv/direnvrc).
export AWS_PROFILE="radix"
export AWS_REGION="us-east-1"
export GIT_PROJECTS_WORKDIR="$HOME/git/rdx"
export LDFLAGS="-L${HOMEBREW_PREFIX:-/opt/homebrew}/opt/openssl/lib"
export CPPFLAGS="-I${HOMEBREW_PREFIX:-/opt/homebrew}/opt/openssl/include"

# Tokens and API keys: scoped to work repos instead of every shell.
source_env_if_exists "$HOME/.config/rdx/secrets.zsh"
