{
  "cleanupPeriodDays": 90,
  "env": {
    "OMC_SKIP_HOOKS": "project-memory"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
{{- /*
  ~/.claude/plans is a symlink into OneDrive (see docs/new-machine.md), which puts every
  plan-mode write outside the working directory. The allow rules need BOTH the symlink
  path and its resolved target, because path rules are matched against each.
  Scoped to claude/plans, never the OneDrive root: the rest of it is company files.

  Path-rule syntax is gitignore-style, so the leading marker matters: "~/..." is
  home-relative, "//..." is filesystem-absolute, and a SINGLE leading slash would mean
  "relative to this settings file's directory". Prefer "~/" for anything under $HOME.
  additionalDirectories accepts the same "~/" form.

  The scratchpad lives under the OS temp root, not ~/.claude: Claude Code builds it as
  <CLAUDE_CODE_TMPDIR or /tmp>/claude-$UID/<project>/<session-uuid>/scratchpad, and on
  macOS /tmp resolves to /private/tmp. It cannot be written as "~/", and the grant is
  the per-uid ROOT, not the leaf: the leaf carries a per-session UUID, so a leaf grant
  can never match the next session and the prompt would return forever.
*/}}
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git tag *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Edit(//{{ if eq .chezmoi.os "darwin" }}private/{{ end }}tmp/claude-{{ .chezmoi.uid }}/**)"
{{- if and .radixils (eq .chezmoi.os "darwin") }},
      "Edit(~/.claude/plans/**)",
      "Edit(~/{{ .machineSync.onedriveRelDir }}/{{ .machineSync.syncRelDir }}/claude/plans/**)"
{{- end }}
    ],
    "additionalDirectories": [
      "{{ if eq .chezmoi.os "darwin" }}/private{{ end }}/tmp/claude-{{ .chezmoi.uid }}"
{{- if and .radixils (eq .chezmoi.os "darwin") }},
      "~/{{ .machineSync.onedriveRelDir }}/{{ .machineSync.syncRelDir }}/claude/plans"
{{- end }}
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true,
  "notifications": {
    "enabled": false
  }
}
