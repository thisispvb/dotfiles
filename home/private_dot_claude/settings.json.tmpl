{
  "cleanupPeriodDays": 90,
  "env": {
    "OMC_SKIP_HOOKS": "project-memory"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
{{- /*
  ~/.claude/plans is a symlink into OneDrive (see docs/new-machine.md), which puts
  every plan-mode write outside the working directory. additionalDirectories takes
  absolute paths only — no ~ expansion — and the allow rules below need BOTH the
  symlink path and its resolved target, because path rules are matched against each.
  Scoped to claude/plans, never the OneDrive root: the rest of it is company files.
*/}}
{{- if and .radixils (eq .chezmoi.os "darwin") }}
    "additionalDirectories": ["{{ includeTemplate "machine-sync-dir" . }}/claude/plans"],
{{- end }}
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git tag *)",
      "Bash(* --version)",
      "Bash(* --help)"
{{- if and .radixils (eq .chezmoi.os "darwin") }},
      "Edit(~/.claude/plans/**)",
      "Write(~/.claude/plans/**)",
      "Edit(/{{ includeTemplate "machine-sync-dir" . }}/claude/plans/**)",
      "Write(/{{ includeTemplate "machine-sync-dir" . }}/claude/plans/**)"
{{- end }}
    ],
    "deny": [
      "Read(~/.config/rdx/secrets.zsh)",
      "Read(~/.config/rdx/env.zsh)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true,
  "notifications": {
    "enabled": false
  }
}
