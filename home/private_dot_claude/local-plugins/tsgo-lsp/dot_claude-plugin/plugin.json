{
  "name": "tsgo-lsp",
  "description": "TypeScript/JavaScript language server from TS 7 native (tsc --lsp --stdio)",
  "version": "1.0.0",
  "lspServers": {
    "typescript": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
