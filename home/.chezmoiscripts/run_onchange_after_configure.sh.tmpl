#!/usr/bin/env bash

set -eufo pipefail

# https://github.com/mathiasbynens/dotfiles/blob/main/.macos

# Trackpad: enable tap to click for this user and for the login screen
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.trackpad.forceClick -bool false
# "Force Click and haptic feedback" off. The driver reads ForceSuppressed;
# com.apple.trackpad.forceClick alone is not enough. Takes effect after logout/restart.
defaults write com.apple.AppleMultitouchTrackpad ForceSuppressed -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad ForceSuppressed -bool true
defaults write NSGlobalDomain shouldShowRSVPDataDetectors -bool false

defaults write -g ApplePressAndHoldEnabled -bool false

defaults write NSGlobalDomain AppleFirstWeekday -dict gregorian -int 2
defaults write NSGlobalDomain AppleICUDateFormatStrings -dict-add 1 "y-MM-dd"
defaults write NSGlobalDomain AppleICUForce24HourTime -bool true
defaults write NSGlobalDomain AppleInterfaceStyle Dark
defaults write NSGlobalDomain AppleLanguages -array en-US
defaults write NSGlobalDomain AppleLocale en_US
defaults write NSGlobalDomain AppleMeasurementUnits -string "Centimeters"
defaults write NSGlobalDomain AppleShowScrollBars -string "Automatic"
defaults write NSGlobalDomain AppleTemperatureUnit -string "Celsius"

defaults write NSGlobalDomain AppleKeyboardUIMode -int 2
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
defaults write NSGlobalDomain InitialKeyRepeat -int 15
defaults write NSGlobalDomain KeyRepeat -int 2

defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticTextCompletionEnabled -bool false
defaults write NSGlobalDomain NSLinguisticDataAssetsRequested -array en en_US
defaults write NSGlobalDomain NSUserDictionaryReplacementItems -array
defaults write NSGlobalDomain WebAutomaticSpellingCorrectionEnabled -bool false

defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0
#defaults write com.apple.dock autohide-time-modifier -float 0
defaults write com.apple.dock orientation bottom
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.dock tilesize -int 48
# Hot corners
# Possible values: 0 no-op; 2 Mission Control; 3 Application windows; 4 Desktop;
# 5 Start screen saver; 6 Disable screen saver; 10 Put display to sleep;
# 11 Launchpad; 12 Notification Center; 13 Lock Screen; 14 Quick Note
defaults write com.apple.dock wvous-tl-corner -int 0
defaults write com.apple.dock wvous-tl-modifier -int 0
defaults write com.apple.dock wvous-tr-corner -int 0
defaults write com.apple.dock wvous-tr-modifier -int 0
defaults write com.apple.dock wvous-bl-corner -int 0
defaults write com.apple.dock wvous-bl-modifier -int 0
defaults write com.apple.dock wvous-br-corner -int 0
defaults write com.apple.dock wvous-br-modifier -int 0

defaults write com.apple.finder CreateDesktop -bool false
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder _FXEnableColumnAutoSizing -bool true
defaults write com.apple.WindowManager HideDesktop -int 1
defaults write com.apple.WindowManager StandardHideDesktopIcons -int 1
defaults write com.apple.WindowManager StandardHideWidgets -int 1

# Require authentication immediately when the screen saver starts or the display turns off.
# Keep the legacy defaults writes for compatibility, then enforce the current setting via sysadminctl.
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0
if /usr/sbin/sysadminctl -h 2>&1 | /usr/bin/grep -q -- '-screenLock'; then
  screen_lock_status="$(/usr/sbin/sysadminctl -screenLock status 2>&1 || true)"
  if [[ "$screen_lock_status" != *"screenLock delay is immediate"* ]]; then
    /usr/sbin/sysadminctl -screenLock immediate -password -
  fi
fi

# Application Firewall on, in stealth mode (no replies to probes such as ping).
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on

# Automatic security updates: background checks, downloads, and the security
# responses/XProtect data that install without a restart.
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool true

# Keep Spotlight out of ~/git: node_modules and build output churn mds/mdworker.
# Same list as System Settings > Spotlight > Search Privacy. Needs Full Disk
# Access for the terminal; warn instead of failing without it.
spotlight_plist=/System/Volumes/Data/.Spotlight-V100/VolumeConfiguration.plist
spotlight_exclude="$HOME/git"
pb() { sudo /usr/libexec/PlistBuddy -c "$1" "$spotlight_plist"; }
if ! pb 'Print :Exclusions' 2>/dev/null | /usr/bin/grep -qxF "    $spotlight_exclude"; then
  pb 'Print :Exclusions' >/dev/null 2>&1 || pb 'Add :Exclusions array' 2>/dev/null || true
  if pb "Add :Exclusions: string $spotlight_exclude" 2>/dev/null; then
    # SIP blocks launchctl kickstart on mds; killing it makes launchd restart it.
    sudo killall mds 2>/dev/null || true
  else
    echo "⚠️  Could not exclude ~/git from Spotlight: grant the terminal Full Disk Access, or add it in System Settings > Spotlight > Search Privacy" >&2
  fi
fi

# Warn-only: these need a person (recovery key, reboot), not a script.
if ! /usr/bin/fdesetup status | /usr/bin/grep -q "FileVault is On"; then
  echo "⚠️  FileVault is off: System Settings -> Privacy & Security -> FileVault" >&2
fi
if ! /usr/sbin/spctl --status 2>&1 | /usr/bin/grep -q "assessments enabled"; then
  echo "⚠️  Gatekeeper is disabled: run 'sudo spctl --global-enable'" >&2
fi

defaults write com.apple.systempreferences NSQuitAlwaysKeepsWindows -bool false
defaults -currentHost write com.apple.controlcenter BatteryShowPercentage -bool true
defaults -currentHost write com.apple.controlcenter Bluetooth -int 18
defaults -currentHost write com.apple.controlcenter Sound -int 18
{{ if .radixils }}
# AirPlay Receiver binds ports 5000 and 7000 via the ControlCenter process, and
# 5000 collides with a Radix ILS service default. Work machines only.
defaults -currentHost write com.apple.controlcenter AirplayReceiverEnabled -bool false
{{ end }}

# Safari's preferences live in a privacy-protected app container on current
# macOS releases. A fresh machine may not have created that container yet, and
# Terminal may not have permission to write it. These preferences should not
# prevent the rest of chezmoi from applying.
#
# Preflight: reading the domain succeeds only when this terminal holds Full Disk
# Access. Without it every write below is silently discarded, so skip the block
# and say what the actual remedy is. Non-fatal either way.
if defaults read com.apple.Safari >/dev/null 2>&1; then
  defaults write com.apple.Safari AlwaysRestoreSessionAtLaunch -bool true
  defaults write com.apple.Safari AutoFillCreditCardData -bool false
  # Passwords live in 1Password, never Safari/the Passwords app. This also
  # suppresses Safari's "save this password?" prompt.
  defaults write com.apple.Safari AutoFillPasswords -bool false
  defaults write com.apple.Safari IncludeDevelopMenu -bool true
  # Safari -> Settings -> Privacy -> "Require Touch ID to view locked tabs"
  defaults write com.apple.Safari PrivateBrowsingRequiresAuthentication -bool false
  defaults write com.apple.Safari ShowOverlayStatusBar -bool true
  defaults write com.apple.Safari WebKitDeveloperExtrasEnabledPreferenceKey -bool true
  defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true
else
  echo "Warning: Safari's preference container is not readable; skipping Safari defaults." >&2
  echo "  Grant Full Disk Access: System Settings -> Privacy & Security -> Full Disk Access" >&2
  echo "  -> add iTerm2 (or Terminal), then re-run: chezmoi apply" >&2
fi

# Calendar. Minutes-from-midnight. Calendar overwrites these on exit, so quit
# it first. Keys really do contain spaces.
if /usr/bin/pgrep -xq Calendar; then
  /usr/bin/osascript -e 'tell application "Calendar" to quit' || true
fi
defaults write com.apple.iCal "first minute of work hours" -int 540   # day starts 09:00
defaults write com.apple.iCal "last minute of work hours" -int 1140   # day ends 19:00
defaults write com.apple.iCal "TimeZone support enabled" -bool true
defaults write com.apple.iCal "Show Week Numbers" -bool true

defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$HOME/.config/iterm2"
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true

defaults write com.google.Chrome AppleEnableSwipeNavigateWithScrolls -bool false
defaults write com.google.Chrome AppleEnableMouseSwipeNavigateWithScrolls -bool false

sudo nvram StartupMute=%01

# AutoFill provider selection and Safari extension enablement are owned by
# AuthenticationServicesAgent and Safari, not by user defaults, so they cannot be
# scripted. Nag once instead of failing.
if ! defaults read com.1password.safari.extension >/dev/null 2>&1; then
  echo "Note: finish the 1Password setup by hand (one time per machine):" >&2
  echo "  1. Safari -> Settings -> Extensions -> enable 1Password for Safari" >&2
  echo "  2. System Settings -> General -> AutoFill & Passwords ->" >&2
  echo "     turn OFF 'Passwords', turn ON '1Password'" >&2
fi

for app in Dock Finder SystemUIServer ControlCenter; do
  killall "$app" 2>/dev/null || true
done

