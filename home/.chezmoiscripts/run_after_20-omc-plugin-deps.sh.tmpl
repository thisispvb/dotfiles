#!/usr/bin/env bash

# Makes the installed oh-my-claudecode plugin runnable. Its MCP server
# (bridge/mcp-server.cjs) and HUD (dist/) are build outputs that upstream
# gitignores, so a marketplace install can arrive without them: the MCP server
# then fails to connect and the HUD falls back to an older cached version.
# A built dir can still lack runtime deps (the HUD fails with "Cannot find
# package 'zod'"). The trigger lives outside chezmoi, so this runs on every
# apply; it is a no-op once the installed version is built and has its deps.

set -eufo pipefail

registry="$HOME/.claude/plugins/installed_plugins.json"
[ -f "$registry" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

dir="$(jq -r '.plugins["oh-my-claudecode@omc"][0].installPath // empty' "$registry")"
[ -n "$dir" ] && [ -f "$dir/package-lock.json" ] || exit 0
version="$(basename "$dir")"

if [ -f "$dir/bridge/mcp-server.cjs" ] && [ -f "$dir/dist/hud/index.js" ] && [ -d "$dir/node_modules/zod" ]; then
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "⚠️  npm is not on PATH — skipping oh-my-claudecode $version; its MCP server and HUD stay broken until it is built" >&2
  exit 0
fi

if [ ! -f "$dir/bridge/mcp-server.cjs" ] || [ ! -f "$dir/dist/hud/index.js" ]; then
  # The native build needs node_api.h and downloads nothing; official Node
  # installs (mise included) ship the headers beside the binary.
  npm_config_nodedir="$(node -p 'require("path").resolve(process.execPath, "../..")')"
  export npm_config_nodedir
  echo "🔨 Building oh-my-claudecode $version"
  (cd "$dir" && npm ci --no-audit --no-fund && npm run build)
else
  echo "📦 Installing oh-my-claudecode $version runtime deps"
  (cd "$dir" && npm ci --omit=dev --no-audit --no-fund)
fi
{{/* vim: set filetype=sh: */}}
