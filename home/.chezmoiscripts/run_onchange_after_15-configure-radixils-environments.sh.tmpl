{{- if .radixils -}}
{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash

set -eufo pipefail

{{ if .manageBrew -}}
echo "📦 Installing Radix ILS packages"

{{ range (.packages.darwin.work.taps | sortAlpha | uniq) -}}
brew trust --tap "{{ . }}"
{{ end -}}
brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range (.packages.darwin.work.taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range (.packages.darwin.work.brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
EOF

# Install Claude Code via native installer (auto-updates)
if ! command -v claude &> /dev/null; then
  echo "📦 Installing Claude Code (native installer)"
  curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}

echo "📦 Configuring Radix ILS tooling"

duckdb -c "install httpfs; install spatial; install h3 from community"

{{ end -}}
{{ end -}}
