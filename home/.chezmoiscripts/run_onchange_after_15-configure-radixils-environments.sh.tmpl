{{- if .radixils -}}
{{- $rdxBrewfile := joinPath .chezmoi.homeDir "git/rdx/rdx/Brewfile" -}}
#!/usr/bin/env bash

# Work machine setup. Dotfiles own cross-repo tooling; rdx owns its own
# (Brewfile, `task setup`, DuckDB). Re-runs when either package list changes:
# rdx Brewfile: {{ if stat $rdxBrewfile }}{{ include $rdxBrewfile | sha256sum }}{{ else }}absent{{ end }}
# ~/git/rdx/.envrc: {{ include "git/rdx/dot_envrc" | sha256sum }}

set -eufo pipefail

{{ if .manageBrew -}}
brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT

{{ range (.packages.darwin.work.taps | sortAlpha | uniq) -}}
brew trust --tap "{{ . }}"
{{ end -}}
cat >"$brewfile" <<BREWFILE
{{ range (.packages.darwin.work.taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range (.packages.darwin.work.brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
BREWFILE

for file in "$brewfile" "{{ $rdxBrewfile }}"; do
  [ -f "$file" ] || continue
  if brew bundle check --no-upgrade --file="$file" >/dev/null; then
    echo "📦 Up to date: $file"
  else
    echo "📦 Installing: $file"
    brew bundle --no-upgrade --file="$file"
  fi
done

# Install Claude Code via native installer (auto-updates)
if ! command -v claude &> /dev/null; then
  echo "📦 Installing Claude Code (native installer)"
  curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}

# ~/git/rdx/.envrc is managed here; trust it so direnv loads the work env.
if command -v direnv >/dev/null 2>&1 && [ -f "$HOME/git/rdx/.envrc" ]; then
  direnv allow "$HOME/git/rdx/.envrc"
fi
{{ end -}}
{{/* vim: set filetype=sh: */}}
