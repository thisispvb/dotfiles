{{- if .manageBrew -}}
#!/usr/bin/env bash

set -eufo pipefail

{{ template "brew-cask-opts" . }}

brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT

{{ range (.packages.darwin.taps | sortAlpha | uniq) -}}
brew trust --tap "{{ . }}"
{{ end -}}
cat >"$brewfile" <<BREWFILE
{{ range (.packages.darwin.taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range (.packages.darwin.brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range (concat .packages.darwin.fontCasks .packages.darwin.casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
{{ range $name, $id := .packages.darwin.mas -}}
mas "{{ $name }}", id: {{ $id }}
{{ end -}}
BREWFILE

# `check` is a fast no-op when everything is already installed.
if brew bundle check --no-upgrade --file="$brewfile" >/dev/null; then
  echo "📦 General packages up to date"
else
  echo "📦 Installing general packages"
  brew bundle --no-upgrade --file="$brewfile"
fi
{{ end -}}
{{/* vim: set filetype=sh: */}}
