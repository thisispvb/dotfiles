{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash

set -eufo pipefail

echo "📦 Setting up asdf (+ installing plugins & tools)"

INSTALLED_PLUGINS=$(asdf plugin list)

# Node/pnpm are no longer managed by asdf (pnpm owns Node; pnpm itself is the
# self-contained binary in $PNPM_HOME). Remove the stale asdf plugins so their
# shims (~/.asdf/shims/{node,pnpm}) vanish and PATH falls through to
# $PNPM_HOME/bin/node and $PNPM_HOME/pnpm.
for plugin in nodejs pnpm; do
  if asdf plugin list | grep -qx "$plugin"; then
    echo "Removing asdf plugin: $plugin (now managed by pnpm/Homebrew)"
    asdf plugin remove "$plugin"
  fi
done

{{ range (list "python" "ruby") -}}
if ! grep -q "{{ . }}" <<< "$INSTALLED_PLUGINS"; then
  asdf plugin add {{ . }}
fi
{{ end -}}

echo "Updating asdf plugins..."
asdf plugin update --all

echo "Installing asdf versions..."
asdf install

echo "Setting up asdf autocompletions..."
asdf completion zsh > "${ASDF_DATA_DIR:-$HOME/.asdf}/completions/_asdf"
{{ end -}}
