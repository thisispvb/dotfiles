{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash

# Installs the global mise toolchain. Re-runs only when the rendered config
# changes:
# config: {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}
# versions: {{ list .versions.node .versions.pnpm .versions.python .versions.rdx | toJson | sha256sum }} role: {{ .machineRole }}

set -eufo pipefail

if ! command -v mise >/dev/null 2>&1; then
  echo "⚠️  mise is not installed — install it with brew (manageBrew account), then re-run chezmoi apply" >&2
  exit 1
fi

echo "📦 Installing the mise toolchain"
mise install --yes
mise reshim

# The old pnpm-managed runtime lived at $PNPM_HOME/pnpm and $PNPM_HOME/bin/node.
# Shells, editors and agents started before the switch still have those paths
# on PATH, so point them at the mise shims instead of deleting them.
pnpm_home="$HOME/.local/share/pnpm"
shims="$HOME/.local/share/mise/shims"
mkdir -p "$pnpm_home/bin"
for tool in node npm npx; do
  ln -sfn "$shims/$tool" "$pnpm_home/bin/$tool"
done
ln -sfn "$shims/pnpm" "$pnpm_home/pnpm"
{{ end -}}
{{/* vim: set filetype=sh: */}}
