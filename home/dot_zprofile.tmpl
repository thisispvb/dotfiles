export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Avoid errors on `ssh-add -A` for macos >= 12
export APPLE_SSH_ADD_BEHAVIOR="macos"

# homebrew — static equivalent of `brew shellenv` (avoids a brew subprocess
# per shell; `output "brew" "shellenv"` can't be used because brew prints
# nothing when PATH already starts with its bin dirs)
{{ if eq .chezmoi.os "darwin" -}}
{{   $brewPrefix := "" -}}
{{   if stat "/opt/homebrew/bin/brew" -}}
{{     $brewPrefix = "/opt/homebrew" -}}
{{   else if stat "/usr/local/bin/brew" -}}
{{     $brewPrefix = "/usr/local" -}}
{{   end -}}
{{   if $brewPrefix -}}
export HOMEBREW_PREFIX="{{ $brewPrefix }}"
export HOMEBREW_CELLAR="{{ $brewPrefix }}/Cellar"
export HOMEBREW_REPOSITORY="{{ if eq $brewPrefix "/usr/local" }}/usr/local/Homebrew{{ else }}{{ $brewPrefix }}{{ end }}"
fpath[1,0]="$HOMEBREW_PREFIX/share/zsh/site-functions"
export FPATH
path=($HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin $path)
[ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
{{   end -}}
{{ end -}}

# go
export GOPATH=$HOME/go
path+=($GOPATH/bin)

# pnpm — $PNPM_HOME/bin holds `pnpm add -g` binaries (pnpm v11 layout). The
# pnpm CLI itself comes from mise.
export PNPM_HOME="$HOME/.local/share/pnpm"
path=($PNPM_HOME/bin $path)

# mise shims ahead of Homebrew. zshenv adds them too, but macOS path_helper
# (/etc/zprofile) moves them behind /usr/bin in login shells.
path=($HOME/.local/share/mise/shims $path)
