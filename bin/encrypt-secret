#!/usr/bin/env bash
# Encrypts a file to one role's age key and stores it as
# home/.secrets/<role>/<name>.age. Needs only the role's public key, so any
# machine can add or replace a secret for either role.
#
#   bin/encrypt-secret <personal|work> <name> [file]   # file defaults to stdin
#
# Then reference it from a target template:
#   {{ include ".secrets/<role>/<name>.age" | decrypt }}
set -eufo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  sed -n '2,10s/^# \{0,1\}//p' "$0" >&2
  exit 2
fi
role="$1" name="$2" src="${3:--}"
case "$name" in
  *[!A-Za-z0-9._-]* | .* | "")
    echo "name may contain only letters, digits, '.', '_' and '-', and must not start with '.'" >&2
    exit 2
    ;;
esac
case "$role" in personal | work) ;; *)
  echo "role must be personal or work" >&2
  exit 2
  ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
recipient="$(chezmoi execute-template "{{ index .ageRecipients \"$role\" }}")"
dest="$root/home/.secrets/$role/$name.age"
mkdir -p "$(dirname "$dest")"
age --armor -r "$recipient" -o "$dest" "$src"
echo "Encrypted to $role -> ${dest#"$root"/}"
