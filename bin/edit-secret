#!/usr/bin/env bash
# Decrypts home/.secrets/<this machine's role>/<name>.age into a private temp
# file, opens $EDITOR, and re-encrypts on save. Only this machine's role can be
# edited here: the other role's key is deliberately not on this machine.
#
#   bin/edit-secret <name>        # e.g. id_ed25519, secrets.zsh
set -eufo pipefail

if [ $# -ne 1 ]; then
  sed -n '2,7s/^# \{0,1\}//p' "$0" >&2
  exit 2
fi
root="$(cd "$(dirname "$0")/.." && pwd)"
role="$(chezmoi execute-template '{{ .machineRole }}')"
identity="$(chezmoi execute-template '{{ .chezmoi.config.age.identity }}')"
file="$root/home/.secrets/$role/$1.age"
[ -f "$file" ] || {
  echo "No such secret: ${file#"$root"/}" >&2
  exit 1
}

umask 077
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
age -d -i "$identity" -o "$tmp/$1" "$file"
cp "$tmp/$1" "$tmp/$1.orig"
"${EDITOR:-vim}" "$tmp/$1"
if cmp -s "$tmp/$1" "$tmp/$1.orig"; then
  echo "Unchanged."
  exit 0
fi
"$root/bin/encrypt-secret" "$role" "$1" "$tmp/$1"
echo "Run 'chezmoi apply' to deploy it."
